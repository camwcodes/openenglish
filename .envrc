# direnv runs this file in BASH, then exports the resulting environment into your
# shell (zsh included). That's why `eval "$(nix print-dev-env)"` works here but not
# when you run it by hand in zsh — no read-only LINENO warning, and PATH applies.
#
# Later, if you add nix-direnv to your Nix config, you can replace the two
# `watch_file` + `eval` lines below with a single:  use flake
# (same result, plus caching).

watch_file flake.nix flake.lock requirements.txt requirements-dev.txt
eval "$(nix print-dev-env)"

# Nix provides the interpreter (python 3.12). Python *packages* come from
# requirements.txt via a project venv, kept identical to CI.
if [ ! -d .venv ]; then
  echo "direnv: creating .venv with $(python3 --version)"
  python3 -m venv .venv
fi
source .venv/bin/activate

# (Re)install deps only when a requirements file changes.
# requirements.txt = the service (CI-identical); requirements-dev.txt = gate/tooling.
if [ requirements.txt -nt .venv/.deps-installed ] || [ requirements-dev.txt -nt .venv/.deps-installed ]; then
  echo "direnv: installing requirements.txt + requirements-dev.txt"
  python3 -m pip install --quiet --upgrade pip
  python3 -m pip install --quiet -r requirements.txt -r requirements-dev.txt
  touch .venv/.deps-installed
fi
